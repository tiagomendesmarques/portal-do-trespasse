# Ambiente: development | staging (site de testes dev.portaldotrespasse.pt) | production
SITE_ENV=development
# URL público (sem barra final)
SITE_URL=http://localhost:3000

# Base de dados. No Google Cloud: postgres://user:pass@host:5432/db
# Sem DATABASE_URL usa PGlite (Postgres embutido) em ./.data/pglite
DATABASE_URL=

# Emails: "log" (não envia, só regista no back-office) ou "smtp"
EMAIL_DRIVER=log
SMTP_HOST=smtp-pt.securemail.pro
SMTP_PORT=465
SMTP_USER=geral@portaldotrespasse.pt
# Nunca no Git: no Google Cloud vem do Secret Manager.
SMTP_PASSWORD=
# Remetente (por omissão o SMTP_USER); o nome vem das Definições do back-office.
EMAIL_FROM_ADDRESS=
# Site de testes: só envia para estes endereços (vírgulas); os outros ficam só registados.
EMAIL_ONLY_TO=

# Proteção do site de testes (Basic Auth). Vazio = desligado.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Tarefas diárias (expirar anúncios, avisos, limpezas): o Cloud Scheduler faz
# POST /api/cron/daily/ com o cabeçalho X-Cron-Secret. Mínimo 16 caracteres.
CRON_SECRET=
