# Ambiente: development | staging | production
SITE_ENV=development
# URL público (sem barra final)
SITE_URL=http://localhost:3000

# Base de dados. Em produção/staging: postgres://user:pass@host:5432/db
# Sem DATABASE_URL usa PGlite (Postgres embutido) em ./.data/pglite
DATABASE_URL=

# Emails: "log" (não envia, só regista no back-office) ou "resend"
EMAIL_DRIVER=log
EMAIL_FROM="Portal do Trespasse <naoresponder@portaldotrespasse.pt>"
RESEND_API_KEY=

# Proteção do staging (Basic Auth). Vazio = desligado.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Tarefas diárias (expirar anúncios, avisos, limpezas): o Cloud Scheduler faz
# POST /api/cron/daily/ com o cabeçalho X-Cron-Secret. Mínimo 16 caracteres.
CRON_SECRET=
